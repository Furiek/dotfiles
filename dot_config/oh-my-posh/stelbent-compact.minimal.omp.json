{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{if .Segments.Git.RepoName}} {{.Segments.Git.RepoName}} {{else}} {{.Folder}} {{end}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "template": "+ {{ if .SSHSession }}ssh {{ end }}{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "background": "#91ddff",
          "foreground": "#100e23",
          "powerline_symbol": "|",
          "options": {
            "style": "agnoster_full",
            "home_icon": "~",
            "folder_icon": "dir",
            "folder_separator_icon": "/"
          },
          "style": "powerline",
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "|",
          "foreground": "#100e23",
          "background": "#95ffa4",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ff9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f26d50{{ end }}",
            "{{ if gt .Ahead 0 }}#89d1dc{{ end }}",
            "{{ if gt .Behind 0 }}#c5b6ad{{ end }}"
          ],
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} {{ .StashCount }}{{ end }} ",
          "options": {
            "branch_ahead_icon": "ahead:",
            "branch_behind_icon": "behind:",
            "branch_gone_icon": "gone",
            "branch_icon": "git:",
            "branch_identical_icon": "=",
            "cherry_pick_icon": "pick:",
            "commit_icon": "commit:",
            "merge_icon": "merge:",
            "no_commits_icon": "[no commits]",
            "rebase_icon": "rebase:",
            "tag_icon": "tag:",
            "fetch_status": true
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "|",
          "foreground": "#100e23",
          "background": "#D6C6EA",
          "template": " {{ if and .Env.CONDA_DEFAULT_ENV (not .Env.VIRTUAL_ENV) }}conda{{ else }}venv{{ end }}:{{ .Venv }}{{ if .Full }} py:{{ .Full }}{{ end }} ",
          "options": {
            "display_mode": "environment",
            "fetch_virtual_env": true,
            "display_default": true,
            "home_enabled": true,
            "folder_name_fallback": false
          }
        },
        {
          "type": "docker",
          "style": "powerline",
          "powerline_symbol": "|",
          "foreground": "#100e23",
          "background": "#B8DCE8",
          "template": " docker:{{ .Context }} ",
          "options": {
            "display_mode": "context"
          }
        },
        {
          "type": "terraform",
          "background": "#ffee58",
          "foreground": "#100e23",
          "powerline_symbol": "|",
          "style": "powerline",
          "template": " {{ .WorkspaceName }}{{ if .Version }} {{ .Version }}{{ end }} "
        },
        {
          "type": "status",
          "background": "#ff8080",
          "foreground": "#292524",
          "powerline_symbol": "|",
          "style": "powerline",
          "template": " exit:{{ .Code }} "
        },
        {
          "type": "time",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": " | {{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "+"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "$"
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}
